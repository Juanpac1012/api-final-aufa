# Configuracion de despliegue - descomentar SOLO lo que se necesite cambiar
# para el servidor real (Windows/Linux, CPU/GPU). Todo lo que no este aca
# (o este comentado) usa el default definido en app/core/config.py.
#
# Importante: no copiar aca los valores default "porque si" - si coinciden
# con el default es codigo muerto, y si algun dia cambia el default en
# config.py, este archivo lo pisaria en silencio sin que se note el porque.

# --- Inferencia ONNX Runtime ---
# Si el servidor tiene GPU NVIDIA con CUDA instalado, descomentar:
# ONNX_PROVIDERS=["CUDAExecutionProvider","CPUExecutionProvider"]

# --- CORS ---
# Cuando exista un dominio real de frontend, restringir aca, ej:
# CORS_ALLOW_ORIGINS=["https://miapp.com"]

# --- Modelos ---
# Ruta absoluta opcional si en el servidor los .onnx viven en otro lugar
# (ej. un volumen montado en Linux):
# MODELS_DIR=/opt/auraface/models

# --- JWT (obligatorio, la app no arranca sin esto) ---
# Secreto para firmar/verificar tokens HS256. Generado con secrets.token_hex(32).
# NUNCA compartir ni subir a git - si se filtra, cualquiera puede firmar tokens
# validos. Usar un valor DISTINTO en cada entorno (dev/prod).
JWT_SECRET_KEY=929cbaeeb352f8d6c60ff818dfbbed7dbba92d03a38c4078b752f2021e83f6b7

# --- Credenciales del backend que consume esta API (obligatorio) ---
# El backend manda esto a POST /auth/token y recibe un JWT de corta duracion.
# AUTH_CLIENT_ID puede ser cualquier identificador; AUTH_CLIENT_SECRET se
# genero con secrets.token_hex(32) - mismo cuidado que con JWT_SECRET_KEY.
AUTH_CLIENT_ID=backend-principal
AUTH_CLIENT_SECRET=eb6a6b4411cb4a13a18666e6f298859f16e53031952daef3ea32858113dafbaa
